# Track code only: everything is ignored unless whitelisted below
/*
!/.gitignore
!/*.py
!/demo/
/demo/*
!/demo/server.py
!/demo/serve_forever.sh
!/demo/tunnel_watchdog.sh
__pycache__/

# TF-IDF baseline (branch ziyang/tfidf): docs, requirements and small result files
!/README_tfidf.md
!/requirements_tfidf.txt
!/results/
/results/*
!/results/tfidf/
/results/tfidf/*
!/results/tfidf/*.md
!/results/tfidf/*.json
!/results/tfidf/*.png
